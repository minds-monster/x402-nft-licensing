
# Required amount in wei (default is 0.0001 ETH = 100000000000000 wei)
REQUIRED_AMOUNT_WEI=100000000000000

# Alchemy API Key for NFT metadata 
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Base network RPC URLs for viem to verify transactions
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Set to true to use Sepolia testnet
IS_TEST=false
