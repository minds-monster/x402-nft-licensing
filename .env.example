# The wallet address to receive the X402 payment
PAYMENT_ADDRESS=0x0000000000000000000000000000000000000000

# Required amount in wei (default is 0.0001 ETH = 100000000000000 wei)
REQUIRED_AMOUNT_WEI=100000000000000

# Alchemy API Key for NFT metadata 
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Base network RPC URL for viem to verify transactions (optional, viem defaults to public endpoint)
BASE_RPC_URL=https://mainnet.base.org
